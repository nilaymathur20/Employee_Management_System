#include <iostream>
#include <algorithm>
using namespace std;

struct Employee {
    int id;
    string name, department, date;
    float salary;
};

Employee e[50];
int n = 0;

// 1. Add Employee
void addEmployee() {
    cout << "Enter ID: ";
    cin >> e[n].id;

    for (int i = 0; i < n; i++) {
        if (e[i].id == e[n].id) {
            cout << "ID already exists!\n";
            return;
        }
    }

    cout << "Enter Name: ";
    cin >> e[n].name;

    cout << "Enter Department: ";
    cin >> e[n].department;

    cout << "Enter Salary: ";
    cin >> e[n].salary;

    cout << "Enter Joining Date: ";
    cin >> e[n].date;

    n++;
    cout << "Employee Added!\n";
}

// 2. Display Employees
void display() {
    if (n == 0) {
        cout << "No Records Found!\n";
        return;
    }

    for (int i = 0; i < n; i++) {
        cout << "\nID: " << e[i].id;
        cout << "\nName: " << e[i].name;
        cout << "\nDepartment: " << e[i].department;
        cout << "\nSalary: " << e[i].salary;
        cout << "\nJoining Date: " << e[i].date << "\n";
    }
}

// 3. Update Employee
void update() {
    int id;
    cout << "Enter ID: ";
    cin >> id;

    for (int i = 0; i < n; i++) {
        if (e[i].id == id) {
            cout << "Enter New Name: ";
            cin >> e[i].name;

            cout << "Enter New Department: ";
            cin >> e[i].department;

            cout << "Enter New Salary: ";
            cin >> e[i].salary;

            cout << "Enter New Date: ";
            cin >> e[i].date;

            cout << "Updated Successfully!\n";
            return;
        }
    }
    cout << "Employee Not Found!\n";
}

// 4. Delete Employee
void deleteEmployee() {
    int id;
    cout << "Enter ID: ";
    cin >> id;

    for (int i = 0; i < n; i++) {
        if (e[i].id == id) {
            for (int j = i; j < n - 1; j++)
                e[j] = e[j + 1];

            n--;
            cout << "Deleted Successfully!\n";
            return;
        }
    }
    cout << "Employee Not Found!\n";
}

// 5. Linear Search
void linearSearch() {
    int id;
    cout << "Enter ID: ";
    cin >> id;

    for (int i = 0; i < n; i++) {
        if (e[i].id == id) {
            cout << "Employee Found: " << e[i].name << "\n";
            return;
        }
    }
    cout << "Not Found!\n";
}

// 6. Binary Search
void binarySearch() {
    sort(e, e + n, [](Employee a, Employee b) {
        return a.id < b.id;
    });

    int id, low = 0, high = n - 1;
    cout << "Enter ID: ";
    cin >> id;

    while (low <= high) {
        int mid = (low + high) / 2;

        if (e[mid].id == id) {
            cout << "Employee Found: " << e[mid].name << "\n";
            return;
        }
        else if (e[mid].id < id)
            low = mid + 1;
        else
            high = mid - 1;
    }

    cout << "Not Found!\n";
}

// Main Function
int main() {
    int choice;

    do {
        cout << "\n--- EMPLOYEE MANAGEMENT SYSTEM ---\n";
        cout << "1. Add Employee\n";
        cout << "2. Display Employees\n";
        cout << "3. Update Employee\n";
        cout << "4. Delete Employee\n";
        cout << "5. Linear Search\n";
        cout << "6. Binary Search\n";
        cout << "7. Exit\n";

        cout << "Enter Choice: ";
        cin >> choice;

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: display(); break;
            case 3: update(); break;
            case 4: deleteEmployee(); break;
            case 5: linearSearch(); break;
            case 6: binarySearch(); break;
            case 7: cout << "Thank You!\n"; break;
            default: cout << "Invalid Choice!\n";
        }

    } while (choice != 7);

    return 0;
}

